# ================= إعدادات نظام المراسلات =================
# انسخ هذا الملف باسم .env وعدّل القيم حسب خادمك

# عنوان خادم قاعدة البيانات (localhost إن كانت على نفس الجهاز)
DB_SERVER=localhost\SQLEXPRESS

# اسم قاعدة البيانات (يُنشأ تلقائياً عبر npm run setup)
DB_NAME=MurasalatDB

# حساب الاتصال بـ SQL Server
DB_USER=sa
DB_PASSWORD=P@ssw0rdy12345

# منفذ SQL Server (الافتراضي 1433)
DB_PORT=1433

# تشفير الاتصال بقاعدة البيانات (false للشبكة المحلية)
DB_ENCRYPT=false

# مفتاح توقيع الجلسات — ضع نصاً عشوائياً طويلاً ولا تشاركه
JWT_SECRET=غيّر-هذا-المفتاح-إلى-نص-عشوائي-طويل

# منفذ تشغيل النظام (تُفتح الواجهة على نفس المنفذ)
PORT=3001

# مجلد المرفقات (نسبة إلى مجلد server)
UPLOAD_DIR=uploads

# أقصى حجم للملف المرفق بالميجابايت
MAX_UPLOAD_MB=15

# بيئة التشغيل
NODE_ENV=production
